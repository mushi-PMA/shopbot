# Copy to agent/.env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...
# Neon (or Supabase) Postgres connection string. Use the pooled URL.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Password for the seller dashboard (/admin) and the /admin API routes
ADMIN_TOKEN=change-me
MODEL=claude-haiku-5-5

# Website build (web/): where the agent API lives
VITE_API_URL=http://localhost:8000
